#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Substitute for `test-tool pkt-line <action>` (t0070, t5703).
#
# The side-band actions test the git library's side-band code (class C) and
# go to `rgit-test-tool pkt-line` (rgit #310), found like in
# sub/rgit-test-tool.sh. `pack`, `pack-raw-stdin` and `unpack` encode
# requests for and decode answers of the git under test (class B, a wire
# compatibility check) and stay with the reference test-tool, as does every
# call when no rgit-test-tool is found (or fail with 127 under
# RGIT_TEST_TOOL_STRICT=1).

case ${1:-} in
unpack-sideband|send-split-sideband|receive-sideband)
	RGIT_TEST_TOOL_SUB=pkt-line exec "$(dirname "$0")/rgit-test-tool.sh" "$@"
	;;
esac

if test "$RGIT_TEST_TOOL_STRICT" = 1
then
	echo "test-tool (rgit): pkt-line ${1:-} has no rgit substitute" >&2
	exit 127
fi
if test -n "$RGIT_TEST_TOOL_FORWARD_LOG"
then
	echo "pkt-line ${1:-}" >>"$RGIT_TEST_TOOL_FORWARD_LOG"
fi
exec "${REF_TEST_TOOL:?REF_TEST_TOOL not set}" pkt-line "$@"
