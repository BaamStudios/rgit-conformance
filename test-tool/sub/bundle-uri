#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Substitute for `test-tool bundle-uri <action> ...` (t5750, t573x).
#
# parse-key-values and parse-config (bundle list parsing, rgit issue #172)
# go to `rgit-test-tool bundle-uri`, found like in sub/rgit-test-tool.sh.
# ls-remote, and every call when no rgit-test-tool is found, go to the
# reference test-tool (or fail with 127 under RGIT_TEST_TOOL_STRICT=1).

case ${1:-} in
parse-key-values|parse-config)
	RGIT_TEST_TOOL_SUB=bundle-uri exec "$(dirname "$0")/rgit-test-tool.sh" "$@"
	;;
esac

if test "$RGIT_TEST_TOOL_STRICT" = 1
then
	echo "test-tool (rgit): bundle-uri ${1:-} has no rgit substitute" >&2
	exit 127
fi
if test -n "$RGIT_TEST_TOOL_FORWARD_LOG"
then
	echo "bundle-uri ${1:-}" >>"$RGIT_TEST_TOOL_FORWARD_LOG"
fi
exec "${REF_TEST_TOOL:?REF_TEST_TOOL not set}" bundle-uri "$@"
